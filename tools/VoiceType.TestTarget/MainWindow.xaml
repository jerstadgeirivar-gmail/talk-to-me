<Window x:Class="VoiceType.TestTarget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VoiceType Test Target"
        Width="620"
        Height="320"
        MinWidth="480"
        MinHeight="260"
        WindowStartupLocation="CenterScreen"
        AutomationProperties.AutomationId="TestTargetWindow"
        AutomationProperties.Name="VoiceType testmål">
    <Grid Margin="28"
          Background="#F2F4F3"
          FocusManager.FocusedElement="{Binding ElementName=TargetEditor}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock FontFamily="Segoe UI Variable Display"
                   FontSize="22"
                   FontWeight="SemiBold"
                   Foreground="#202522"
                   Text="Trygt tekstmål" />
        <TextBox x:Name="TargetEditor"
                 Grid.Row="1"
                 Margin="0,16,0,0"
                 Padding="12"
                 AcceptsReturn="True"
                 AcceptsTab="True"
                 Background="White"
                 BorderBrush="#AAB4AE"
                 FontFamily="Segoe UI Variable Text"
                 FontSize="16"
                 Foreground="#202522"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 AutomationProperties.AutomationId="TargetEditor"
                 AutomationProperties.Name="Tekstfelt for innsetting" />
    </Grid>
</Window>
