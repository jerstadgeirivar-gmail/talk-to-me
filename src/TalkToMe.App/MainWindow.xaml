<Window x:Class="TalkToMe.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TalkToMe"
        Width="520"
        Height="630"
        MinWidth="440"
        MinHeight="520"
        Icon="/Assets/TalkToMe.ico"
        WindowStartupLocation="CenterScreen"
        AutomationProperties.AutomationId="MainWindow"
        AutomationProperties.Name="TalkToMe main window">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock FontFamily="Segoe UI Variable Display, Segoe UI"
                           FontSize="25"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource NavyBrush}"
                           Text="TalkToMe" />
                <TextBlock Margin="0,3,0,0"
                           Foreground="{StaticResource MutedTextBrush}"
                           Text="Norwegian dictation" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button MinWidth="88"
                        Style="{StaticResource SecondaryButton}"
                        Content="Settings"
                        Click="OpenSettings"
                        AutomationProperties.AutomationId="SettingsButton"
                        AutomationProperties.Name="Open settings" />
                <Button MinWidth="98"
                        Margin="8,0,0,0"
                        Style="{StaticResource SecondaryButton}"
                        Content="Hide to tray"
                        Click="HideToTray"
                        AutomationProperties.AutomationId="HideToTrayButton"
                        AutomationProperties.Name="Hide TalkToMe to the system tray" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                Margin="0,18,0,14"
                Padding="15,12"
                Background="{StaticResource AccentSoftBrush}"
                BorderBrush="#CAE4D8"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource EyebrowText}" Text="CURRENT STATUS" />
                <TextBlock Grid.Column="1"
                           VerticalAlignment="Top"
                           FontFamily="Cascadia Mono, Consolas"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource NavyBrush}"
                           Text="{Binding DurationText}"
                           AutomationProperties.AutomationId="RecordingDurationText"
                           AutomationProperties.Name="{Binding DurationText}" />
                <TextBlock Grid.Row="1"
                           Grid.ColumnSpan="2"
                           Margin="0,4,0,0"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="#12583F"
                           Text="{Binding StatusText}"
                           TextWrapping="Wrap"
                           AutomationProperties.AutomationId="RecordingStatusText"
                           AutomationProperties.Name="{Binding StatusText}" />
                <StackPanel Grid.Row="2"
                            Grid.ColumnSpan="2"
                            Margin="0,8,0,0"
                            Orientation="Horizontal">
                    <TextBlock Style="{StaticResource EyebrowText}" Text="INPUT  " />
                    <TextBlock FontSize="12"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="{Binding SourceText}"
                               TextTrimming="CharacterEllipsis"
                               AutomationProperties.AutomationId="AudioSourceText"
                               AutomationProperties.Name="{Binding SourceText}" />
                </StackPanel>
                <StackPanel Grid.Row="3"
                            Grid.ColumnSpan="2"
                            Margin="0,5,0,0"
                            Orientation="Horizontal">
                    <TextBlock Style="{StaticResource EyebrowText}" Text="VOICE COMMAND  " />
                    <TextBlock FontSize="12"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="{Binding VoiceCommandText}"
                               AutomationProperties.AutomationId="VoiceCommandStatusText"
                               AutomationProperties.Name="{Binding VoiceCommandText}" />
                </StackPanel>
                <ProgressBar Grid.ColumnSpan="2"
                             Grid.Row="4"
                             Height="4"
                             Margin="0,8,0,0"
                             Minimum="0"
                             Maximum="100"
                             Value="{Binding InputLevel, Mode=OneWay}"
                             AutomationProperties.AutomationId="InputLevelIndicator"
                             AutomationProperties.Name="Microphone level" />
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Margin="0,0,0,10"
                Padding="12,9"
                Background="{StaticResource SurfaceMutedBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource EyebrowText}" Text="TARGET" />
                <TextBlock Grid.Column="1"
                           Margin="10,0,0,0"
                           Foreground="{StaticResource TextBrush}"
                           Text="{Binding TargetText}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding TargetText}"
                           AutomationProperties.AutomationId="TargetWindowText"
                           AutomationProperties.Name="{Binding TargetText}" />
            </Grid>
        </Border>

        <Border Grid.Row="3"
                Padding="16,14"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource SectionTitleText}" Text="Transcript" />
                <TextBox Grid.Row="1"
                         Margin="0,10,0,0"
                         Padding="0"
                         MinHeight="150"
                         VerticalContentAlignment="Top"
                         VerticalScrollBarVisibility="Auto"
                         Background="Transparent"
                         BorderThickness="0"
                         FontSize="15"
                         IsReadOnly="True"
                         Text="{Binding TranscriptText, Mode=OneWay}"
                         TextWrapping="Wrap"
                         AutomationProperties.AutomationId="TranscriptTextBox"
                         AutomationProperties.Name="Transcript" />
            </Grid>
        </Border>

        <Grid Grid.Row="4" Margin="0,14,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"
                    Margin="0,0,5,0"
                    Style="{StaticResource PrimaryButton}"
                    Content="Start recording"
                    Command="{Binding StartRecordingCommand}"
                    AutomationProperties.AutomationId="StartRecordingButton"
                    AutomationProperties.Name="Start recording" />
            <Button Grid.Column="1"
                    Margin="5,0"
                    Style="{StaticResource SecondaryButton}"
                    Content="Stop recording"
                    Command="{Binding StopRecordingCommand}"
                    AutomationProperties.AutomationId="StopRecordingButton"
                    AutomationProperties.Name="Stop recording" />
            <Button Grid.Column="2"
                    Margin="5,0,0,0"
                    Content="Insert transcript"
                    Command="{Binding InsertCommand}"
                    AutomationProperties.AutomationId="InsertButton"
                    AutomationProperties.Name="Insert transcript">
                <Button.Style>
                    <Style BasedOn="{StaticResource SecondaryButton}" TargetType="{x:Type Button}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <Trigger Property="IsEnabled" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <Button Grid.Row="1"
                    Grid.Column="0"
                    Margin="0,8,5,0"
                    Style="{StaticResource SecondaryButton}"
                    Content="Cancel"
                    Command="{Binding CancelCommand}"
                    AutomationProperties.AutomationId="CancelButton" />
            <Button Grid.Row="1"
                    Grid.Column="1"
                    Margin="5,8,5,0"
                    Content="Retry transcription"
                    Command="{Binding RetryCommand}"
                    AutomationProperties.AutomationId="RetryButton">
                <Button.Style>
                    <Style BasedOn="{StaticResource SecondaryButton}" TargetType="{x:Type Button}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <Trigger Property="IsEnabled" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Grid.Row="1"
                    Grid.Column="2"
                    Margin="5,8,0,0"
                    Content="Delete recording"
                    Command="{Binding DeletePendingCommand}"
                    AutomationProperties.AutomationId="DeletePendingAudioButton">
                <Button.Style>
                    <Style BasedOn="{StaticResource DangerButton}" TargetType="{x:Type Button}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <Trigger Property="IsEnabled" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>

        <Grid Grid.Row="5" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center"
                       FontSize="11"
                       Foreground="{StaticResource MutedTextBrush}"
                       Text="{Binding VersionText}"
                       AutomationProperties.AutomationId="ApplicationVersionText" />
            <TextBlock Grid.Column="1"
                       Margin="10,0"
                       VerticalAlignment="Center"
                       FontSize="11"
                       Foreground="{StaticResource MutedTextBrush}"
                       Text="{Binding UpdateStatusText}"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding UpdateStatusText}"
                       AutomationProperties.AutomationId="UpdateStatusText" />
            <Button Grid.Column="2"
                    Padding="10,4"
                    Style="{StaticResource SecondaryButton}"
                    Content="Check for updates"
                    Command="{Binding CheckForUpdatesCommand}"
                    AutomationProperties.AutomationId="CheckForUpdatesButton" />
        </Grid>
    </Grid>
</Window>
