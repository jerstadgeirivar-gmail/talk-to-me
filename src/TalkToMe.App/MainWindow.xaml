<Window x:Class="TalkToMe.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TalkToMe.App"
        mc:Ignorable="d"
        Title="TalkToMe"
        Width="520"
        Height="630"
        MinWidth="440"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        AutomationProperties.AutomationId="MainWindow"
        AutomationProperties.Name="TalkToMe main window">
    <Grid Background="#F4F1EA">
        <Border Margin="28"
                Padding="28"
                Background="#FFFFFF"
                BorderBrush="#D8D2C7"
                BorderThickness="1"
                CornerRadius="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock FontFamily="Segoe UI Variable Display"
                               FontSize="26"
                               FontWeight="SemiBold"
                               Foreground="#202522"
                               Text="TalkToMe" />
                    <TextBlock Margin="0,8,0,0"
                               FontFamily="Segoe UI Variable Text"
                               FontSize="14"
                               Foreground="#555C57"
                               Text="Norwegian dictation, ready when you are."
                               TextWrapping="Wrap" />
                    <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe UI Variable Text"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#66706A"
                                   Text="AUDIO SOURCE  " />
                        <TextBlock FontFamily="Segoe UI Variable Text"
                                   FontSize="13"
                                   Foreground="#343A36"
                                   Text="{Binding SourceText}"
                                   AutomationProperties.AutomationId="AudioSourceText"
                                   AutomationProperties.Name="{Binding SourceText}" />
                    </StackPanel>
                    <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                        <Button Width="118"
                                Height="32"
                                Background="#FFFFFF"
                                BorderBrush="#A7AEA9"
                                Content="Settings"
                                Click="OpenSettings"
                                AutomationProperties.AutomationId="SettingsButton"
                                AutomationProperties.Name="Open settings" />
                        <Button Width="118"
                                Height="32"
                                Margin="8,0,0,0"
                                Background="#FFFFFF"
                                BorderBrush="#A7AEA9"
                                Content="Hide to tray"
                                Click="HideToTray"
                                AutomationProperties.AutomationId="HideToTrayButton"
                                AutomationProperties.Name="Hide TalkToMe to the system tray" />
                    </StackPanel>
                </StackPanel>

                <Border Grid.Row="1"
                    Margin="0,20,0,20"
                    Padding="16,10"
                        VerticalAlignment="Center"
                        Background="#EDF3EF"
                        CornerRadius="4">
                    <StackPanel>
                        <TextBlock FontFamily="Segoe UI Variable Text"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#526057"
                                   Text="STATUS" />
                        <TextBlock Margin="0,5,0,0"
                                   FontFamily="Segoe UI Variable Text"
                                   FontSize="16"
                                   Foreground="#173B2B"
                                   Text="{Binding StatusText}"
                                   AutomationProperties.AutomationId="RecordingStatusText"
                                   AutomationProperties.Name="{Binding StatusText}" />
                            <TextBlock Margin="0,8,0,0"
                                   FontFamily="Consolas"
                                   FontSize="14"
                                   Foreground="#526057"
                                   Text="{Binding DurationText}"
                                   AutomationProperties.AutomationId="RecordingDurationText"
                                   AutomationProperties.Name="{Binding DurationText}" />
                            <ProgressBar Height="7"
                                     Margin="0,12,0,0"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="{Binding InputLevel, Mode=OneWay}"
                                     AutomationProperties.AutomationId="InputLevelIndicator"
                                     AutomationProperties.Name="Microphone level" />
                        <TextBlock Margin="0,18,0,0"
                                   FontFamily="Segoe UI Variable Text"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#526057"
                                   Text="TRANSCRIPT" />
                        <TextBox Height="92"
                                 Margin="0,7,0,0"
                                 Padding="9,7"
                                 VerticalScrollBarVisibility="Auto"
                                 Background="#FFFFFF"
                                 BorderBrush="#C8D2CB"
                                 BorderThickness="1"
                                 FontFamily="Segoe UI Variable Text"
                                 FontSize="14"
                                 Foreground="#202522"
                                 IsReadOnly="True"
                                 Text="{Binding TranscriptText, Mode=OneWay}"
                                 TextWrapping="Wrap"
                                 AutomationProperties.AutomationId="TranscriptTextBox"
                                 AutomationProperties.Name="Transcript" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="2">
                    <StackPanel Orientation="Horizontal">
                        <Button Width="124"
                                Height="42"
                                Padding="18,8"
                                Background="#145A3A"
                                BorderBrush="#145A3A"
                                Foreground="White"
                                FontFamily="Segoe UI Variable Text"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Content="Start recording"
                                Command="{Binding StartRecordingCommand}"
                                AutomationProperties.AutomationId="StartRecordingButton"
                                AutomationProperties.Name="Start recording" />
                        <Button Width="124"
                                Height="42"
                                Margin="6,0,0,0"
                                Padding="18,8"
                                Background="#FFFFFF"
                                BorderBrush="#A7AEA9"
                                Foreground="#2C332E"
                                FontFamily="Segoe UI Variable Text"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Content="Stop recording"
                                Command="{Binding StopRecordingCommand}"
                                AutomationProperties.AutomationId="StopRecordingButton"
                                AutomationProperties.Name="Stop recording" />
                        <Button Width="124"
                                Height="42"
                                Margin="6,0,0,0"
                                Padding="18,8"
                                Background="#FFFFFF"
                                BorderBrush="#A7AEA9"
                                Foreground="#2C332E"
                                FontFamily="Segoe UI Variable Text"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Content="Insert"
                                Command="{Binding InsertCommand}"
                                AutomationProperties.AutomationId="InsertButton"
                                AutomationProperties.Name="Insert transcript" />
                    </StackPanel>
                    <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                        <Button Width="124"
                                Height="34"
                                Content="Cancel"
                                Command="{Binding CancelCommand}"
                                AutomationProperties.AutomationId="CancelButton" />
                        <Button Width="124"
                                Height="34"
                                Margin="6,0,0,0"
                                Content="Retry"
                                Command="{Binding RetryCommand}"
                                AutomationProperties.AutomationId="RetryButton" />
                        <Button Width="124"
                                Height="34"
                                Margin="6,0,0,0"
                                Content="Delete audio"
                                Command="{Binding DeletePendingCommand}"
                                AutomationProperties.AutomationId="DeletePendingAudioButton" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
