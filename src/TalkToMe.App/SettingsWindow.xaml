<Window x:Class="TalkToMe.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TalkToMe Settings" Width="760" Height="920" MinWidth="560" MinHeight="560"
        Icon="/Assets/TalkToMe.ico" WindowStartupLocation="CenterOwner"
        AutomationProperties.AutomationId="SettingsWindow" AutomationProperties.Name="TalkToMe settings">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="28,22,28,12">
            <TextBlock FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource NavyBrush}" Text="Settings"/>
            <TextBlock Margin="0,3,0,0" Foreground="{StaticResource MutedTextBrush}" Text="Choose how dictation is transcribed and configure application behavior."/>
        </StackPanel>
        <TabControl Grid.Row="1" Margin="24,0,24,12" AutomationProperties.AutomationId="SettingsTabs">
            <TabItem Header="Transcription" AutomationProperties.AutomationId="TranscriptionTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="16">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Transcription provider"/>
                        <ComboBox Margin="0,6,0,4" ItemsSource="{Binding Providers}" DisplayMemberPath="DisplayName"
                                  SelectedValuePath="Id" SelectedValue="{Binding SelectedProviderId}"
                                  AutomationProperties.AutomationId="ProviderSelector" AutomationProperties.Name="Transcription provider"/>
                        <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="{Binding SelectedProvider.Description}" TextWrapping="Wrap"/>

                        <Border Margin="0,14,0,0" Padding="16" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                            <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsLocalWhisper}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitleText}" Text="Local Whisper"/>
                                <TextBlock Margin="0,8,0,0" Text="Whisper small-q5_1 (multilingual) · CPU · Norwegian · works offline" TextWrapping="Wrap"/>
                                <TextBlock Margin="0,5,0,0" Foreground="{StaticResource MutedTextBrush}" Text="Audio stays on this computer. The pinned model is verified with SHA-256 before use." TextWrapping="Wrap"/>
                                <Button Margin="0,12,0,0" HorizontalAlignment="Left" Style="{StaticResource SecondaryButton}" Content="Repair model" Click="RepairModel" AutomationProperties.AutomationId="RepairModelButton"/>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,14,0,0" Padding="16" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                            <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsAzure}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitleText}" Text="Transcription endpoints"/>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <ComboBox ItemsSource="{Binding EndpointProfiles}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding SelectedEndpointId}" SelectionChanged="SelectEndpoint" AutomationProperties.AutomationId="EndpointProfileSelector" AutomationProperties.Name="Transcription endpoint"/>
                                    <Button Grid.Column="1" Width="36" Height="36" Padding="0" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" Click="AddEndpoint" ToolTip="Add endpoint" AutomationProperties.AutomationId="AddEndpointButton"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE710;"/></Button>
                                    <Button Grid.Column="2" Width="36" Height="36" Padding="0" Margin="4,0,0,0" Style="{StaticResource SecondaryButton}" Click="DuplicateEndpoint" ToolTip="Duplicate endpoint without its credential" AutomationProperties.AutomationId="DuplicateEndpointButton"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8C8;"/></Button>
                                    <Button Grid.Column="3" Width="36" Height="36" Padding="0" Margin="4,0,0,0" Style="{StaticResource DangerButton}" Click="RemoveEndpoint" IsEnabled="{Binding CanRemoveEndpoint}" ToolTip="Remove endpoint" AutomationProperties.AutomationId="RemoveEndpointButton"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE74D;"/></Button>
                                </Grid>
                                <TextBlock Margin="0,10,0,5" Style="{StaticResource FieldLabel}" Text="Profile name"/>
                                <TextBox Text="{Binding EndpointName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="EndpointNameTextBox"/>
                                <TextBlock Margin="0,10,0,5" Style="{StaticResource FieldLabel}" Text="Endpoint"/>
                                <TextBox Text="{Binding AzureEndpoint, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="AzureEndpointTextBox"/>
                                <TextBlock Margin="0,10,0,5" Style="{StaticResource FieldLabel}" Text="Deployment"/>
                                <TextBox Text="{Binding AzureDeployment, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="AzureDeploymentTextBox"/>
                                <TextBlock Margin="0,10,0,5" Style="{StaticResource FieldLabel}" Text="API version"/>
                                <TextBox Text="{Binding AzureApiVersion, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="AzureApiVersionTextBox"/>
                                <CheckBox Margin="0,12,0,0" Content="OpenAI-compatible route" IsChecked="{Binding OpenAiCompatibleRoute}" ToolTip="Use an API base URL ending in /v1; requests go to audio/transcriptions. Unchecked uses the Azure deployment route." AutomationProperties.AutomationId="OpenAiRouteCheckBox"/>
                                <CheckBox Margin="0,8,0,0" Content="Bearer token authentication" IsChecked="{Binding BearerAuthentication}" ToolTip="Unchecked sends the protected credential in the api-key header." AutomationProperties.AutomationId="BearerAuthenticationCheckBox"/>
                                <DockPanel Margin="0,10,0,5"><TextBlock Style="{StaticResource FieldLabel}" Text="API key"/><TextBlock HorizontalAlignment="Right" Text="{Binding AzureSecretStatus}" AutomationProperties.AutomationId="ApiKeyStatusText" AutomationProperties.Name="{Binding AzureSecretStatus}"/></DockPanel>
                                <PasswordBox x:Name="ApiKeyPasswordBox" AutomationProperties.AutomationId="ApiKeyPasswordBox" AutomationProperties.Name="Replace Azure API key"/>
                                <Button Margin="0,8,0,0" HorizontalAlignment="Left" Style="{StaticResource DangerButton}" Content="Remove Azure key" Click="RemoveAzureKey" AutomationProperties.AutomationId="RemoveApiKeyButton"/>
                                <Expander Margin="0,16,0,0" Header="Segment limits" IsExpanded="True">
                                    <StackPanel Margin="0,8,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Maximum output tokens"/>
                                            <TextBlock Grid.Column="2" Style="{StaticResource FieldLabel}" Text="Estimated tokens / minute"/>
                                            <TextBox Grid.Row="1" Margin="0,5,0,12" Text="{Binding MaximumOutputTokens, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" ToolTip="Planning budget from the endpoint's documented model limit; not sent as an unsupported API parameter." AutomationProperties.AutomationId="MaximumOutputTokensTextBox"/>
                                            <TextBox Grid.Row="1" Grid.Column="2" Margin="0,5,0,12" Text="{Binding EstimatedTokensPerMinute, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" ToolTip="Conservative speech-density estimate. Segment planning uses 75% of the output-token budget." AutomationProperties.AutomationId="EstimatedTokensPerMinuteTextBox"/>
                                            <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="Maximum segment seconds"/>
                                            <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource FieldLabel}" Text="Maximum upload bytes"/>
                                            <TextBox Grid.Row="3" Margin="0,5,0,12" Text="{Binding MaximumSegmentSeconds, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" AutomationProperties.AutomationId="MaximumSegmentSecondsTextBox"/>
                                            <TextBox Grid.Row="3" Grid.Column="2" Margin="0,5,0,12" Text="{Binding MaximumUploadBytes, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" AutomationProperties.AutomationId="MaximumUploadBytesTextBox"/>
                                            <TextBlock Grid.Row="4" Style="{StaticResource FieldLabel}" Text="Request timeout seconds"/>
                                            <TextBlock Grid.Row="4" Grid.Column="2" Style="{StaticResource FieldLabel}" Text="Planned segment ceiling"/>
                                            <TextBox Grid.Row="5" Margin="0,5,0,0" Text="{Binding RequestTimeoutSeconds, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" AutomationProperties.AutomationId="RequestTimeoutSecondsTextBox"/>
                                            <TextBlock Grid.Row="5" Grid.Column="2" Margin="0,5,0,0" VerticalAlignment="Center" Text="{Binding SegmentPlanText}" AutomationProperties.AutomationId="SegmentPlanText"/>
                                        </Grid>
                                        <CheckBox Margin="0,14,0,0" Content="Keep encrypted partial transcripts for resume" IsChecked="{Binding RetainProgress}" ToolTip="Current-user DPAPI protection. Completed jobs are removed; interrupted jobs expire after 14 days." AutomationProperties.AutomationId="RetainTranscriptionProgressCheckBox"/>
                                        <Button Margin="0,8,0,0" HorizontalAlignment="Left" Style="{StaticResource SecondaryButton}" Content="Clear saved progress" Click="ClearProgress" AutomationProperties.AutomationId="ClearTranscriptionProgressButton"/>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,14,0,0" Padding="16" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                            <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsLmStudio}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
                            <StackPanel><TextBlock Style="{StaticResource SectionTitleText}" Text="LM Studio"/><TextBlock Margin="0,6" Foreground="{StaticResource DangerBrush}" Text="Current official LM Studio APIs do not expose speech-to-text. Test checks reachability and reports this limitation; audio is never sent to chat." TextWrapping="Wrap"/>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Base URL"/><TextBox Text="{Binding LmStudioBaseUrl}" AutomationProperties.AutomationId="LmStudioBaseUrlTextBox"/>
                                <TextBlock Margin="0,10,0,5" Style="{StaticResource FieldLabel}" Text="Model (reserved for a future documented audio API)"/><TextBox Text="{Binding LmStudioModel}" AutomationProperties.AutomationId="LmStudioModelTextBox"/>
                                <TextBlock Margin="0,10,0,5" Style="{StaticResource FieldLabel}" Text="Optional server token"/><PasswordBox x:Name="LmStudioTokenPasswordBox" AutomationProperties.AutomationId="LmStudioTokenPasswordBox"/>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,14,0,0" Padding="16" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                            <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsOllama}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
                            <StackPanel><TextBlock Style="{StaticResource SectionTitleText}" Text="Ollama"/><TextBlock Margin="0,6" Foreground="{StaticResource DangerBrush}" Text="Current official Ollama APIs do not expose speech-to-text. Test checks reachability and reports this limitation; audio is never sent to chat." TextWrapping="Wrap"/>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Base URL"/><TextBox Text="{Binding OllamaBaseUrl}" AutomationProperties.AutomationId="OllamaBaseUrlTextBox"/>
                                <TextBlock Margin="0,10,0,5" Style="{StaticResource FieldLabel}" Text="Model (reserved for a future documented audio API)"/><TextBox Text="{Binding OllamaModel}" AutomationProperties.AutomationId="OllamaModelTextBox"/>
                                <TextBlock Margin="0,10,0,5" Style="{StaticResource FieldLabel}" Text="Optional server token"/><PasswordBox x:Name="OllamaTokenPasswordBox" AutomationProperties.AutomationId="OllamaTokenPasswordBox"/>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,14,0,0" Padding="12" Background="{StaticResource AccentSoftBrush}" CornerRadius="6">
                            <StackPanel><TextBlock FontWeight="SemiBold" Text="Provider status"/><TextBlock Margin="0,3,0,0" Text="{Binding ProviderStatus}" TextWrapping="Wrap" AutomationProperties.AutomationId="ProviderStatusText" AutomationProperties.Name="{Binding ProviderStatus}"/><TextBlock Text="{Binding ProgressText}"/></StackPanel>
                        </Border>
                        <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                            <Button Style="{StaticResource PrimaryButton}" Content="Test provider" Click="TestProvider" AutomationProperties.AutomationId="TestProviderButton"/>
                            <Button Margin="8,0,0,0" Content="Cancel operation" Click="CancelOperation" AutomationProperties.AutomationId="CancelProviderOperationButton">
                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Dictation" AutomationProperties.AutomationId="DictationTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Transcription language"/>
                    <ComboBox Margin="0,6,0,4" ItemsSource="{Binding TranscriptionLanguages}" DisplayMemberPath="DisplayName"
                              SelectedValuePath="Id" SelectedValue="{Binding TranscriptionLanguageMode}"
                              AutomationProperties.AutomationId="TranscriptionLanguageSelector" AutomationProperties.Name="Transcription language"/>
                    <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="Norwegian prevents incorrect Swedish or Chinese detection. Norwegian + English also hints that English words and sentences may occur." TextWrapping="Wrap"/>
                    <TextBlock Margin="0,14,0,5" Style="{StaticResource FieldLabel}" Text="Vocabulary file"/>
                    <TextBox IsReadOnly="True" TextWrapping="Wrap" Text="{Binding VocabularyFilePath, Mode=OneWay}" AutomationProperties.AutomationId="VocabularyFilePathTextBox"/>
                    <Button Margin="0,8,0,0" HorizontalAlignment="Left" Style="{StaticResource SecondaryButton}" Content="Edit vocabulary" Click="EditVocabulary" AutomationProperties.AutomationId="EditVocabularyButton"/>
                    <TextBlock Margin="0,14,0,5" Style="{StaticResource FieldLabel}" Text="Global hotkey"/><TextBox Text="{Binding Hotkey}" AutomationProperties.AutomationId="HotkeyTextBox"/>
                    <CheckBox Margin="0,16,0,0" Content="Enable “computer” voice command" IsChecked="{Binding VoiceCommandsEnabled}" AutomationProperties.AutomationId="VoiceCommandsEnabledCheckBox"/>
                    <CheckBox Margin="0,12,0,0" Content="Keep audio after failed transcription" IsChecked="{Binding RetainFailedAudio}" AutomationProperties.AutomationId="RetainFailedAudioCheckBox"/>
                    <CheckBox Margin="0,12,0,0" Content="Start with Windows" IsChecked="{Binding StartWithWindows}" AutomationProperties.AutomationId="StartWithWindowsCheckBox"/>
                    <CheckBox Margin="0,12,0,0" Content="Copy to clipboard only" IsChecked="{Binding ClipboardOnlyMode}" AutomationProperties.AutomationId="ClipboardOnlyCheckBox"/>
                </StackPanel></ScrollViewer>
            </TabItem>
        </TabControl>
        <Border Grid.Row="2" Padding="28,12" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Foreground="{StaticResource DangerBrush}" Text="{Binding StatusText}" TextWrapping="Wrap" AutomationProperties.AutomationId="SettingsStatusText" AutomationProperties.Name="{Binding StatusText}"/>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal"><Button MinWidth="90" Style="{StaticResource SecondaryButton}" Content="Close" Click="CloseSettings" AutomationProperties.AutomationId="CloseSettingsButton"/><Button MinWidth="110" Margin="8,0,0,0" Style="{StaticResource PrimaryButton}" Content="Save settings" Click="SaveSettings" AutomationProperties.AutomationId="SaveSettingsButton"/></StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
