<Window x:Class="VoiceType.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VoiceType Settings"
        Width="620"
        Height="760"
        MinWidth="540"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        AutomationProperties.AutomationId="SettingsWindow"
        AutomationProperties.Name="VoiceType settings">
    <Grid Background="#F4F1EA">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32">
                <TextBlock FontFamily="Segoe UI Variable Display"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Text="Settings" />

                <TextBlock Margin="0,22,0,5" Text="Azure endpoint" />
                <TextBox Height="34"
                         Padding="8,5"
                         Text="{Binding AzureEndpoint, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.AutomationId="AzureEndpointTextBox"
                         AutomationProperties.Name="Azure endpoint" />
                <TextBlock Margin="0,14,0,5" Text="Deployment name" />
                <TextBox Height="34"
                         Padding="8,5"
                         Text="{Binding AzureDeployment, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.AutomationId="AzureDeploymentTextBox"
                         AutomationProperties.Name="Deployment name" />
                <TextBlock Margin="0,14,0,5" Text="API version" />
                <TextBox Height="34"
                         Padding="8,5"
                         Text="{Binding AzureApiVersion, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.AutomationId="AzureApiVersionTextBox"
                         AutomationProperties.Name="API version" />

                <DockPanel Margin="0,16,0,5">
                    <TextBlock Text="API key" />
                    <TextBlock HorizontalAlignment="Right"
                               FontWeight="SemiBold"
                               Text="{Binding KeyStatusText}"
                               AutomationProperties.AutomationId="ApiKeyStatusText"
                               AutomationProperties.Name="{Binding KeyStatusText}" />
                </DockPanel>
                <PasswordBox x:Name="ApiKeyPasswordBox"
                             Height="34"
                             Padding="8,5"
                             AutomationProperties.AutomationId="ApiKeyPasswordBox"
                             AutomationProperties.Name="Replace API key" />

                <TextBlock Margin="0,16,0,5" Text="Technical vocabulary and context" />
                <TextBox Height="92"
                         Padding="8"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Text="{Binding TechnicalVocabulary, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.AutomationId="VocabularyTextBox"
                         AutomationProperties.Name="Technical vocabulary" />

                <CheckBox Margin="0,18,0,0"
                          Content="Keep audio after failed transcription"
                          IsChecked="{Binding RetainFailedAudio}"
                          AutomationProperties.AutomationId="RetainFailedAudioCheckBox" />
                <CheckBox Margin="0,10,0,0"
                          Content="Start with Windows"
                          IsChecked="{Binding StartWithWindows}"
                          AutomationProperties.AutomationId="StartWithWindowsCheckBox" />
                <CheckBox Margin="0,10,0,0"
                          Content="Copy to clipboard only"
                          IsChecked="{Binding ClipboardOnlyMode}"
                          AutomationProperties.AutomationId="ClipboardOnlyCheckBox" />

                <TextBlock Margin="0,18,0,0"
                           Foreground="#9A2E22"
                           Text="{Binding StatusText}"
                           TextWrapping="Wrap"
                           AutomationProperties.AutomationId="SettingsStatusText"
                           AutomationProperties.Name="{Binding StatusText}" />

                <StackPanel Margin="0,20,0,0" Orientation="Horizontal">
                    <Button Width="120"
                            Height="38"
                            Content="Save"
                            Click="SaveSettings"
                            AutomationProperties.AutomationId="SaveSettingsButton" />
                    <Button Width="150"
                            Height="38"
                            Margin="10,0,0,0"
                            Content="Remove API key"
                            Click="RemoveApiKey"
                            AutomationProperties.AutomationId="RemoveApiKeyButton" />
                    <Button Width="100"
                            Height="38"
                            Margin="10,0,0,0"
                            Content="Close"
                            Click="CloseSettings"
                            AutomationProperties.AutomationId="CloseSettingsButton" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
