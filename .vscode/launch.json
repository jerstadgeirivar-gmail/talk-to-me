      "preLaunchTask": "build TalkToMe App",
      "program": "${workspaceFolder}/src/TalkToMe.App/bin/Debug/net10.0-windows/TalkToMe.App.dll",
      "cwd": "${workspaceFolder}/src/TalkToMe.App",
